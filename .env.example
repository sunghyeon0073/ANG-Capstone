# Copy this file to .env and fill in the real deployment values.
# docker compose reads .env from the repository root.

DB_URL=jdbc:mariadb://your-rds-endpoint:3306/your_database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
ADMIN_INIT_PASSWORD=change-this-admin-password

# Optional: comma-separated origins allowed to call the backend.
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500,http://15.168.156.224:5500

# Optional service URLs.
AI_BASE_URL=http://ai:8888
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=ang-ai:latest

# Optional AWS S3 credentials, required only when S3 upload/download is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
